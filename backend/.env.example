# ─────────────────────────────────────────────
#  ConectaFome Backend — Environment Variables
#  Copie este arquivo para .env e preencha.
# ─────────────────────────────────────────────

# Aplicação
NODE_ENV=development
PORT=3333
APP_URL=http://localhost:5173

# Banco de Dados (PostgreSQL)
DATABASE_URL="postgresql://conectfome:conectfome@localhost:5432/conectfome_db"

# JWT
JWT_SECRET=troque_este_segredo_em_producao_min_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque_este_segredo_de_refresh_em_producao_32c
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS — domínios permitidos (separados por vírgula)
CORS_ORIGINS=http://localhost:5173

# ─── Administrador inicial (OBRIGATÓRIO em produção) ───
# Em NODE_ENV=production o seed cria SÓ este administrador (senha com 12+
# caracteres, diferente da senha pública de demonstração). Em desenvolvimento
# o seed cria contas de exemplo e estas variáveis são ignoradas.
# ADMIN_EMAIL=coordenacao@suaong.org.br
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrador ConectaFome
# SEED_DEMO=true   # só para uma demonstração pública: cria as contas de exemplo (senha pública!)

# ─── Geocodificação (endereço -> mapa das rotas) ───
# Nominatim/OpenStreetMap: 1 requisição por segundo e User-Agent identificado.
# GEOCODING_ENABLED=true
# GEOCODING_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_USER_AGENT=ConectaFome/1.0 (projeto academico; github.com/hlima-dev/ConectFome)

# ─── Limites de requisições por IP (a cada 15 min) ───
# Padrões: 100 gerais e 10 de login. Só aumente em teste/captura de telas.
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX=10
